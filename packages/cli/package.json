{
  "name": "@dongmingzhixiu/vuexir",
  "version": "0.4.5",
  "description": "vrn 命令行：build ios|android、preview、doctor",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vuexir": "./bin/vrn.mjs",
    "vrn": "./bin/vrn.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
