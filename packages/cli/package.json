  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs --only cli"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongmingzhixiu/vuexir.git",
